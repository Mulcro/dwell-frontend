// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
//
// `//` starts a comment in xcconfig, so a URL can't be written literally.
// SLASH is the conventional workaround — leave it exactly as it is.
SLASH = /

SUPABASE_HOST = lcsyjslwhdzlfyegbaii.supabase.co
SUPABASE_URL = https:$(SLASH)$(SLASH)$(SUPABASE_HOST)

// The PUBLISHABLE key (sb_publishable_…) — never an sb_secret_… key.
// A secret key bypasses RLS and would give every app user full database access.
SUPABASE_PUBLISHABLE_KEY =

// YouVersion app key — client-side credential, used for the PKCE flow.
YOUVERSION_APP_KEY =
